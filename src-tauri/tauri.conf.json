{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Novel Memory Engine",
  "version": "0.1.0",
  "identifier": "com.local.novel-memory-engine",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Novel Memory Engine",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "resources": ["../prompts/*"]
  }
}
